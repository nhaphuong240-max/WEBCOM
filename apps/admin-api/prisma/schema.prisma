generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  status      String       @default("active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  brands      Brand[]
  users       User[]
  storefronts Storefront[]
  products    Product[]
  priceLists  PriceList[]
  carts       Cart[]
  customers   Customer[]
  orders      Order[]
  auditLogs   AuditLog[]
  idempotency IdempotencyRecord[]
  themes      Theme[]
  mediaAssets MediaAsset[]
  leads       Lead[]

  @@map("tenants")
}

model Brand {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  name        String
  code        String
  createdAt   DateTime     @default(now()) @map("created_at")
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  storefronts Storefront[]
  products    Product[]
  priceLists  PriceList[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("brands")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  email     String
  name      String
  roles     String[] @default([])
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Storefront {
  id               String            @id @default(uuid())
  tenantId         String            @map("tenant_id")
  brandId          String            @map("brand_id")
  name             String
  slug             String
  status           String            @default("draft") // draft|staging|published|maintenance
  primaryDomain    String?           @map("primary_domain")
  seoTitle         String?           @map("seo_title")
  seoDescription   String?           @map("seo_description")
  gtmContainerId   String?           @map("gtm_container_id")
  metaPixelId      String?           @map("meta_pixel_id")
  publishedThemeVersionId String?    @map("published_theme_version_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  brand            Brand             @relation(fields: [brandId], references: [id])
  carts            Cart[]
  orders           Order[]
  themes           Theme[]
  pages            Page[]
  navigationMenus  NavigationMenu[]
  events           StorefrontEvent[]
  vouchers         Voucher[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([primaryDomain])
  @@map("storefronts")
}

model Product {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  brandId     String           @map("brand_id")
  title       String
  slug        String
  description String           @default("")
  status      String           @default("active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  brand       Brand            @relation(fields: [brandId], references: [id])
  variants    ProductVariant[]
  media       ProductMedia[]

  @@unique([tenantId, slug])
  @@index([tenantId, brandId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  title     String
  options   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skus      Sku[]

  @@index([tenantId, productId])
  @@map("product_variants")
}

model Sku {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  variantId     String             @map("variant_id")
  code          String
  barcode       String?
  status        String             @default("active")
  createdAt     DateTime           @default(now()) @map("created_at")
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  prices        PriceListItem[]
  inventory     InventoryBalance?
  reservations  StockReservation[]
  cartLines     CartLine[]
  orderLines    OrderLine[]
  stockLedgers  StockLedger[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("skus")
}

model ProductMedia {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  url       String
  alt       String   @default("")
  sortOrder Int      @default(0) @map("sort_order")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@map("product_media")
}

model PriceList {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  brandId   String          @map("brand_id")
  name      String
  currency  String          @default("VND")
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at")
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  brand     Brand           @relation(fields: [brandId], references: [id])
  items     PriceListItem[]

  @@index([tenantId, brandId])
  @@map("price_lists")
}

model PriceListItem {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  priceListId     String    @map("price_list_id")
  skuId           String    @map("sku_id")
  amount          Decimal   @db.Decimal(18, 2)
  compareAtAmount Decimal?  @map("compare_at_amount") @db.Decimal(18, 2)
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  priceList       PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  sku             Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([priceListId, skuId])
  @@index([tenantId, skuId])
  @@map("price_list_items")
}

model InventoryBalance {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  skuId     String   @unique @map("sku_id")
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  sku       Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("inventory_balances")
}

model StockReservation {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  skuId     String    @map("sku_id")
  orderId   String?   @map("order_id")
  qty       Int
  status    String    @default("active")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  sku       Sku       @relation(fields: [skuId], references: [id])
  order     Order?    @relation(fields: [orderId], references: [id])

  @@index([tenantId, skuId, status])
  @@map("stock_reservations")
}

model StockLedger {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  skuId     String   @map("sku_id")
  delta     Int
  reason    String
  refType   String?  @map("ref_type")
  refId     String?  @map("ref_id")
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")
  sku       Sku      @relation(fields: [skuId], references: [id])

  @@index([tenantId, skuId])
  @@map("stock_ledgers")
}

model Customer {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String?
  phone        String?
  passwordHash String?  @map("password_hash")
  name         String   @default("")
  consentMarketing Boolean @default(false) @map("consent_marketing")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  carts        Cart[]
  orders       Order[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

model Cart {
  id            String     @id @default(uuid())
  tenantId      String     @map("tenant_id")
  storefrontId  String     @map("storefront_id")
  customerId    String?    @map("customer_id")
  currency      String     @default("VND")
  status        String     @default("open")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  storefront    Storefront @relation(fields: [storefrontId], references: [id])
  customer      Customer?  @relation(fields: [customerId], references: [id])
  lines         CartLine[]

  @@index([tenantId, status])
  @@map("carts")
}

model CartLine {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  cartId    String   @map("cart_id")
  skuId     String   @map("sku_id")
  qty       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku       Sku      @relation(fields: [skuId], references: [id])

  @@unique([cartId, skuId])
  @@index([tenantId])
  @@map("cart_lines")
}

model Order {
  id               String             @id @default(uuid())
  tenantId         String             @map("tenant_id")
  storefrontId     String             @map("storefront_id")
  customerId       String?            @map("customer_id")
  cartId           String?            @map("cart_id")
  status           String             @default("CONFIRMED")
  currency         String             @default("VND")
  subtotalAmount   Decimal            @map("subtotal_amount") @db.Decimal(18, 2)
  discountAmount   Decimal            @default(0) @map("discount_amount") @db.Decimal(18, 2)
  shippingAmount   Decimal            @default(0) @map("shipping_amount") @db.Decimal(18, 2)
  totalAmount      Decimal            @map("total_amount") @db.Decimal(18, 2)
  paymentMethod    String             @map("payment_method")
  paymentStatus    String             @default("pending") @map("payment_status")
  shippingName     String             @map("shipping_name")
  shippingPhone    String             @map("shipping_phone")
  shippingAddress  String             @map("shipping_address")
  shippingCity     String             @default("") @map("shipping_city")
  note             String             @default("")
  idempotencyKey   String?            @map("idempotency_key")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  storefront       Storefront         @relation(fields: [storefrontId], references: [id])
  customer         Customer?          @relation(fields: [customerId], references: [id])
  lines            OrderLine[]
  reservations     StockReservation[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("orders")
}

model OrderLine {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  orderId     String  @map("order_id")
  skuId       String  @map("sku_id")
  skuCode     String  @map("sku_code")
  title       String
  qty         Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(18, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         Sku     @relation(fields: [skuId], references: [id])

  @@index([tenantId, orderId])
  @@map("order_lines")
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  key          String
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  statusCode   Int      @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("idempotency_records")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

/// Built-in / installed theme (W2: Aura Commerce Lite)
model Theme {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  storefrontId String        @map("storefront_id")
  code        String
  name        String
  status      String         @default("installed") // installed|archived
  createdAt   DateTime       @default(now()) @map("created_at")
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  storefront  Storefront     @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  versions    ThemeVersion[]

  @@unique([storefrontId, code])
  @@index([tenantId])
  @@map("themes")
}

model ThemeVersion {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  themeId   String   @map("theme_id")
  version   Int
  status    String   @default("draft") // draft|staging|published
  /// JSON: tokens, sections layout for Aura Commerce Lite
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  theme     Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, version])
  @@index([tenantId])
  @@map("theme_versions")
}

model Page {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  storefrontId String        @map("storefront_id")
  slug         String
  title        String
  templateKey  String        @default("home") @map("template_key") // home|collection|system
  status       String        @default("draft")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  storefront   Storefront    @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  versions     PageVersion[]

  @@unique([storefrontId, slug])
  @@index([tenantId])
  @@map("pages")
}

model PageVersion {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  pageId    String   @map("page_id")
  version   Int
  status    String   @default("draft")
  /// Section blocks JSON
  content   Json     @default("{}")
  seo       Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([tenantId])
  @@map("page_versions")
}

model MediaAsset {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  url       String
  alt       String   @default("")
  mimeType  String   @default("image/jpeg") @map("mime_type")
  width     Int?
  height    Int?
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("media_assets")
}

model NavigationMenu {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  storefrontId String     @map("storefront_id")
  handle       String     // header|footer|bottom
  items        Json       @default("[]")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@unique([storefrontId, handle])
  @@index([tenantId])
  @@map("navigation_menus")
}

model StorefrontEvent {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  storefrontId String     @map("storefront_id")
  name         String
  sessionId    String?    @map("session_id")
  customerId   String?    @map("customer_id")
  payload      Json       @default("{}")
  createdAt    DateTime   @default(now()) @map("created_at")
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([tenantId, storefrontId, name])
  @@index([createdAt])
  @@map("storefront_events")
}

model Voucher {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  storefrontId String     @map("storefront_id")
  code         String
  type         String     @default("percent") // percent|fixed
  value        Decimal    @db.Decimal(18, 2)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@unique([storefrontId, code])
  @@index([tenantId])
  @@map("vouchers")
}

/// Corporate GTM leads (E-W2-07)
model Lead {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  email     String
  phone     String?
  company   String?
  channel   String   @default("website")
  message   String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("leads")
}
