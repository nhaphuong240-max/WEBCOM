}

/// B1 — Unified inbox conversation · FR-SOC-001/002
model InboxConversation {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  channelAccountId String   @map("channel_account_id")
  externalThreadId String   @map("external_thread_id")
  customerId       String?  @map("customer_id")
  contactName      String   @default("") @map("contact_name")
  contactHandle    String   @default("") @map("contact_handle")
  /// open | pending | closed
  status           String   @default("open")
  ownerId          String?  @map("owner_id")
  tags             String[] @default([])
  notes            String   @default("")
  /// ok | warning | breached
  slaStatus        String   @default("ok") @map("sla_status")
  slaDueAt         DateTime? @map("sla_due_at")
  lastMessageAt    DateTime  @default(now()) @map("last_message_at")
  lastMessagePreview String  @default("") @map("last_message_preview")
  unreadCount      Int       @default(0) @map("unread_count")
  createdAt        DateTime  @default(now()) @map("created_at")
