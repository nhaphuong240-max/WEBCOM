}

/// B2 — Social order draft (comment/chat → OMS) · FR-SOC-004/005 · BR-023 · FR-OMS-010
model SocialOrderDraft {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  storefrontId       String   @map("storefront_id")
  conversationId     String   @map("conversation_id")
  messageId          String?  @map("message_id")
  channelAccountId   String   @map("channel_account_id")
  /// BR-023: channel thread ID bắt buộc
  externalThreadId   String   @map("external_thread_id")
  /// comment | chat | messenger_cart
  source             String   @default("chat")
  /// draft | cart_sent | converted | cancelled
  status             String   @default("draft")
  /// 0–100 soft risk
  riskScore          Int      @default(0) @map("risk_score")
  riskFlags          String[] @default([]) @map("risk_flags")
  contactName        String   @default("") @map("contact_name")
  contactPhone       String   @default("") @map("contact_phone")
  shippingName       String   @default("") @map("shipping_name")
  shippingPhone      String   @default("") @map("shipping_phone")
  shippingAddress    String   @default("") @map("shipping_address")
  shippingCity       String   @default("") @map("shipping_city")
  /// COD | TRANSFER
  paymentMethod      String   @default("COD") @map("payment_method")
  currency           String   @default("VND")
  subtotalAmount     Decimal  @default(0) @map("subtotal_amount") @db.Decimal(18, 2)
  /// BR-023 product snapshot lines (frozen at draft time)
  linesSnapshot      Json     @default("[]") @map("lines_snapshot")
  /// post/reel/context from comment-to-order
  sourceContext      Json     @default("{}") @map("source_context")
  /// stub Messenger cart payload (FR-SOC-005)
  messengerCart      Json?    @map("messenger_cart")
  cartId             String?  @map("cart_id")
  orderId            String?  @unique @map("order_id")
  note               String   @default("")
  createdBy          String?  @map("created_by")
  convertedAt        DateTime? @map("converted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation       InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  order              Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, conversationId])
  @@index([tenantId, externalThreadId])
  @@map("social_order_drafts")
}

