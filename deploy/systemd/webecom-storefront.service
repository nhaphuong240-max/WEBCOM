[Unit]
Description=WebCom storefront (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/webecom/apps/storefront-web/.next/standalone/apps/storefront-web
Environment=NODE_ENV=production
EnvironmentFile=/var/www/webecom/.env
Environment=PORT=3102
Environment=HOSTNAME=127.0.0.1
Environment=INTERNAL_API_URL=http://127.0.0.1:3101
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
