# Environment template — copy to apps/*/.env as needed
NODE_ENV=development

# Auth (W0/W1 local JWT — replace with Keycloak/OIDC in staging+)
JWT_SECRET=ptt-w0-dev-secret-change-me
JWT_ISSUER=ptt-local
AUTH_DEV_BYPASS=true

# Database (docker compose default)
DATABASE_URL=postgresql://ptt:ptt@localhost:5432/ptt_commerce?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Observability
OTEL_ENABLED=false
SENTRY_DSN=

# Apps
ADMIN_API_PORT=3001
ADMIN_WEB_URL=http://localhost:3000
STOREFRONT_WEB_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001
NEXT_PUBLIC_TENANT_ID=ten_aura
NEXT_PUBLIC_BRAND_ID=brd_aura
NEXT_PUBLIC_STOREFRONT_ID=sf_aura

# Feature flags (undefined = on)
FEATURE_MARKETPLACE=true
FEATURE_BUILDER_V1=true
FEATURE_CMS_REGISTRY_V1=true
FEATURE_CMS_PACKAGE_RESOLVE=true
FEATURE_CMS_DEMO_PACKAGE=true
FEATURE_CMS_BUILDER_CANVAS=true
FEATURE_CMS_BLOG=true
FEATURE_CMS_SAVED_BLOCKS=true
FEATURE_CMS_AI_COPY=true
FEATURE_GOLIVE_GATE=true
# CORP-CMS-0 — Platform CMS dual-path on corporate-web (default off = legacy UI)
FEATURE_PLATFORM_CMS=false
# CORP-CMS-1 (undefined ≈ on): FEATURE_CMS_PLATFORM_REGISTRY_V1 / FEATURE_BUILDER_PLATFORM
FEATURE_DOMAIN_TLS=true
FEATURE_ANALYTICS_CONSENT_GATE=true
FEATURE_PAYMENT_QR=true
FEATURE_PAYMENT_SIMULATE=true
FEATURE_LIVE_SHIPPING=false
FEATURE_REDPANDA=true
FEATURE_CLICKHOUSE=true
FEATURE_ANALYTICS_BACKFILL=true
FEATURE_CH_DIRECT_FALLBACK=true
FEATURE_TEMPORAL=true
FEATURE_OPENSEARCH=true
FEATURE_SEARCH_BACKFILL=true
FEATURE_AI_GATEWAY=true
FEATURE_SOCIAL_LIVE=false
FEATURE_SHOPEE_LIVE=false

# HR (IAM + Employee + Shift) — ADR-006 · docs/specs/hr-implementation-plan.md
# HR-0: catalog in @ptt/shared-kernel; API/UI từ HR-1. Undefined = on (trừ SHIFT/MFA/HRM_PRO).
FEATURE_HR_IAM=true
FEATURE_HR_EMPLOYEE=true
FEATURE_HR_SHIFT=true
FEATURE_HR_MFA=false
FEATURE_HRM_PRO=false
# Optional partner ids when FEATURE_SHOPEE_LIVE=true (still stub send until live partner wired)
# SHOPEE_PARTNER_ID=
# MARKETPLACE_STOCK_LAG_SLO_MS=60000

# A1 multi-tenant host
PLATFORM_APEX_DOMAIN=ptt.shop
# DOMAIN_FORCE_FAIL_DNS=1

# A2 payment / shipping
PAYMENT_WEBHOOK_SECRET=ptt-dev-webhook-secret
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=PTT WEBCOM
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHN_FROM_DISTRICT_ID=1454
# GHN_TO_DISTRICT_ID=1442
CHECKOUT_RATE_LIMIT_RPM=30

# A3 analytics pipeline (stub by default; set URLs for live)
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_BACKFILL_DAYS=7
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_DB=webcom
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# REDPANDA_BROKERS=127.0.0.1:9092
# REDPANDA_HTTP_PROXY=http://127.0.0.1:8082
# REDPANDA_TOPIC_EVENTS=webcom.storefront.events

# A4 Temporal
# TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=webcom
TEMPORAL_TASK_QUEUE=webcom-publish
TEMPORAL_MAX_ATTEMPTS=3
TEMPORAL_PUBLISH_ATTEMPTS=3

# A5 OpenSearch
SEARCH_P95_SLO_MS=200
# OPENSEARCH_URL=http://127.0.0.1:9200
# OPENSEARCH_INDEX_PRODUCTS=webcom-products
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=

# A6 AI Gateway
AI_TENANT_BUDGET_USD=5
AI_MODEL=stub-llm-v1
# AI_GATEWAY_URL=http://127.0.0.1:3104
# AI_GATEWAY_KEY=
AI_GATEWAY_PORT=3104

# B1 Social inbox (stub by default)
SOCIAL_SLA_MINUTES=15
# META_APP_ID=
# META_APP_SECRET=
# ZALO_APP_ID=
# ZALO_APP_SECRET=

# Customer OTP stub
OTP_DEV_CODE=000000
