meta {
  name: WebCom-C5
  type: folder
}

meta {
  name: Health C5
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/api/health
}

meta {
  name: Journey status
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/api/v1/admin/journeys/status
  headers {
    x-tenant-id: {{tenantId}}
    x-brand-id: {{brandId}}
  }
}

meta {
  name: Create journey
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/api/v1/admin/journeys
  headers {
    content-type: application/json
    x-tenant-id: {{tenantId}}
    x-brand-id: {{brandId}}
  }
  body: json
  {
    "name": "Welcome",
    "category": "onboarding",
    "status": "active",
    "required_consent": ["email", "marketing"],
    "steps": [
      { "kind": "trigger", "config": { "type": "manual" } },
      { "kind": "action", "config": { "type": "tag", "tag": "welcome" } },
      { "kind": "exit", "config": {} }
    ]
  }
}

meta {
  name: Enroll
  type: http
  seq: 4
}
post {
  url: {{baseUrl}}/api/v1/admin/journeys/{{journeyId}}/enroll
  headers {
    content-type: application/json
    x-tenant-id: {{tenantId}}
    x-brand-id: {{brandId}}
  }
  body: json
  {
    "customer_id": "{{customerId}}"
  }
}

meta {
  name: Drain
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/v1/admin/journeys/drain
  headers {
    content-type: application/json
    x-tenant-id: {{tenantId}}
    x-brand-id: {{brandId}}
  }
  body: json
  {
    "limit": 50
  }
}
