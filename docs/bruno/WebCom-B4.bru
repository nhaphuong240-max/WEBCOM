meta {
  name: WebCom B4
}

get {
  url: {{BASE}}/api/health
}

get {
  url: {{BASE}}/api/v1/admin/live/status
  headers: {
    x-tenant-id: ten_aura
    x-actor-id: bruno
  }
}

post {
  url: {{BASE}}/api/v1/admin/live/sessions
  headers: {
    x-tenant-id: ten_aura
    x-actor-id: bruno
    content-type: application/json
  }
  body: json
  json: {
    "title": "Bruno Live",
    "host_name": "Bruno",
    "storefront_id": "sf_aura",
    "gmv_target": 1000000,
    "stock_alert_threshold": 5
  }
}
