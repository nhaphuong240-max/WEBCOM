  json: {
    "phone": "0901234567",
    "email": "lan@aura.local",
    "name": "Lan Nguyen",
    "tags": ["vip"],
    "consent_marketing": true,
    "consent_email": true,
    "consent_sms": true
  }
}

get {
  url: {{BASE}}/api/v1/admin/customers?q=Lan
